{
  "name": "crm-bee",
  "version": "1.0.0",
  "private": true,
  "description": "Conversational CRM - Twenty CRM with WhatsApp and Teams integration",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "APP_ROLE=worker node dist/main",
    "start:scheduler": "APP_ROLE=scheduler node dist/main",
    "migrate": "node dist/database/migrate.js",
    "migrate:generate": "drizzle-kit generate",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.11.3",
    "ioredis": "^5.6.0",
    "jose": "^5.9.0",
    "libphonenumber-js": "^1.12.0",
    "luxon": "^3.5.0",
    "mailparser": "^3.7.0",
    "music-metadata": "7.14.0",
    "pg-boss": "^10.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.14.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.10.0",
    "@types/luxon": "^3.4.0",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "redis-memory-server": "^0.17.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}