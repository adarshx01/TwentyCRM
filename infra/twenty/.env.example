# Pin a full release. Do not use latest in anything you care about.
TAG=v2.39.5

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

REDIS_URL=redis://redis:6379

SERVER_URL=http://localhost:3000

# openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_a_random_string
# FALLBACK_ENCRYPTION_KEY=
# APP_SECRET=

STORAGE_TYPE=local

DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false

# Twenty product email (invites). Leave commented locally.
# Campaign mail is sent by apps/outreach, not by these variables.
# EMAIL_FROM_ADDRESS=contact@recruitmentbricks.ai
# EMAIL_FROM_NAME=Recruitment Bricks
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
