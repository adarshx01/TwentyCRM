# Pulls the official CRM image. Build context must be the repo root.
FROM twentycrm/twenty:v2.39.5
USER root
COPY infra/twenty/start-server.sh /usr/local/bin/start-twenty-server
RUN chmod 0755 /usr/local/bin/start-twenty-server
USER 1000
ENTRYPOINT ["/usr/local/bin/start-twenty-server"]
CMD ["node", "dist/main"]
