# Railway project charismatic-flow — paste into each service → Variables.
# Map: TwentyCRM = outreach | reliable-rejoicing = CRM server | vigilant-blessing = CRM worker
# Use Variable → Add variable reference for ${{...}} lines. Do not type hostnames by hand.
# Generate ENCRYPTION_KEY and APP_SECRET once; paste the same values on server AND worker.

# -----------------------------------------------------------------------------
# reliable-rejoicing  (CRM UI)
# Settings → Source: Root Directory = infra/twenty
# Settings → Build: Dockerfile path = Dockerfile.server
# Networking: Generate Domain. Health: /healthz. Start command EMPTY.
# Root Directory MUST be infra/twenty or this service builds outreach by mistake.
# -----------------------------------------------------------------------------
PORT=8080
NODE_PORT=8080
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}?family=0
SERVER_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
ENCRYPTION_KEY=
APP_SECRET=
STORAGE_TYPE=S_3
STORAGE_S3_REGION=auto
STORAGE_S3_NAME=${{indexed-packetcase.BUCKET}}
STORAGE_S3_ENDPOINT=${{indexed-packetcase.ENDPOINT}}
STORAGE_S3_ACCESS_KEY_ID=${{indexed-packetcase.ACCESS_KEY_ID}}
STORAGE_S3_SECRET_ACCESS_KEY=${{indexed-packetcase.SECRET_ACCESS_KEY}}

# -----------------------------------------------------------------------------
# vigilant-blessing  (CRM worker — no public domain)
# Settings → Source: Root Directory = infra/twenty
# Settings → Build: Dockerfile path = Dockerfile.worker
# Start command EMPTY
# -----------------------------------------------------------------------------
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}?family=0
SERVER_URL=https://${{reliable-rejoicing.RAILWAY_PUBLIC_DOMAIN}}
ENCRYPTION_KEY=
APP_SECRET=
DISABLE_DB_MIGRATIONS=true
DISABLE_CRON_JOBS_REGISTRATION=true
STORAGE_TYPE=S_3
STORAGE_S3_REGION=auto
STORAGE_S3_NAME=${{indexed-packetcase.BUCKET}}
STORAGE_S3_ENDPOINT=${{indexed-packetcase.ENDPOINT}}
STORAGE_S3_ACCESS_KEY_ID=${{indexed-packetcase.ACCESS_KEY_ID}}
STORAGE_S3_SECRET_ACCESS_KEY=${{indexed-packetcase.SECRET_ACCESS_KEY}}

# -----------------------------------------------------------------------------
# TwentyCRM  (outreach API — twentycrm-production-3324… )
# Dockerfile stays the repo-root Dockerfile. Root Directory EMPTY.
# After CRM login: Settings → APIs & Webhooks → API key → TWENTY_API_KEY
# -----------------------------------------------------------------------------
NODE_ENV=production
OUTREACH_SEND_ENABLED=false
REDIS_URL=${{Redis.REDIS_URL}}/1?family=0
TWENTY_BASE_URL=https://${{reliable-rejoicing.RAILWAY_PUBLIC_DOMAIN}}
TWENTY_API_KEY=
OUTREACH_API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FROM_EMAIL=sales@recruitmentbricks.ai
FROM_NAME=Recruitment Bricks
