# Paste these in Railway → clever-compassion → each service → Variables.
# Name plugins/services exactly: Redis, Postgres, twenty-storage, twenty-server, twenty-worker, TwentyCRM (outreach).
# Shared secrets: generate once (openssl rand -base64 32) and reuse. Do not commit them.

# =============================================================================
# Redis plugin  (+ New → Database → Redis)  name: Redis
# =============================================================================
# No extra vars. Railway provides REDIS_URL / REDIS_PASSWORD.

# =============================================================================
# Postgres plugin  (+ New → Database → PostgreSQL)  name: Postgres
# =============================================================================
# No extra vars. Railway provides DATABASE_URL.

# =============================================================================
# Bucket  (+ New → Bucket / object storage)  name: twenty-storage
# =============================================================================
# Optional for a first login. Required for attachments. Railway provides
# BUCKET, ENDPOINT, ACCESS_KEY_ID, SECRET_ACCESS_KEY.

# =============================================================================
# twenty-server  (GitHub adarshx01/TwentyCRM, Dockerfile: infra/twenty/Dockerfile.server)
# Public domain = the CRM UI you open in the browser. Health: /healthz
# =============================================================================
PORT=8080
NODE_PORT=8080
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}?family=0
SERVER_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
ENCRYPTION_KEY=
APP_SECRET=
STORAGE_TYPE=S_3
STORAGE_S3_REGION=auto
STORAGE_S3_NAME=${{twenty-storage.BUCKET}}
STORAGE_S3_ENDPOINT=${{twenty-storage.ENDPOINT}}
STORAGE_S3_ACCESS_KEY_ID=${{twenty-storage.ACCESS_KEY_ID}}
STORAGE_S3_SECRET_ACCESS_KEY=${{twenty-storage.SECRET_ACCESS_KEY}}

# If the bucket does not exist yet, comment STORAGE_* above and use:
# STORAGE_TYPE=local

# =============================================================================
# twenty-worker  (same repo, Dockerfile: infra/twenty/Dockerfile.worker)
# No public domain. Copy ENCRYPTION_KEY and APP_SECRET from twenty-server.
# =============================================================================
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}?family=0
SERVER_URL=https://${{twenty-server.RAILWAY_PUBLIC_DOMAIN}}
ENCRYPTION_KEY=
APP_SECRET=
DISABLE_DB_MIGRATIONS=true
DISABLE_CRON_JOBS_REGISTRATION=true
STORAGE_TYPE=S_3
STORAGE_S3_REGION=auto
STORAGE_S3_NAME=${{twenty-storage.BUCKET}}
STORAGE_S3_ENDPOINT=${{twenty-storage.ENDPOINT}}
STORAGE_S3_ACCESS_KEY_ID=${{twenty-storage.ACCESS_KEY_ID}}
STORAGE_S3_SECRET_ACCESS_KEY=${{twenty-storage.SECRET_ACCESS_KEY}}

# =============================================================================
# TwentyCRM (outreach)  — existing GitHub service, Dockerfile: /Dockerfile
# After Twenty UI is up: Settings → APIs & Webhooks → API key → TWENTY_API_KEY
# =============================================================================
NODE_ENV=production
OUTREACH_SEND_ENABLED=false
REDIS_URL=${{Redis.REDIS_URL}}/1?family=0
TWENTY_BASE_URL=https://${{twenty-server.RAILWAY_PUBLIC_DOMAIN}}
TWENTY_API_KEY=
OUTREACH_API_TOKEN=
TWENTY_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FROM_EMAIL=sales@recruitmentbricks.ai
FROM_NAME=Recruitment Bricks
RESEND_API_KEY=

# TWENTY_API_KEY and OUTREACH_API_TOKEN have no Railway reference. Paste by hand.
# WEBHOOK (optional): https://<outreach-domain>/internal/twenty/webhook
