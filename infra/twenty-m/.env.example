# Shared multi-workspace Twenty for the platform plane (see docs/platform-plane.md).
#   cp .env.example .env && sed -i "s/CHANGE_ME_PG/$(openssl rand -hex 16)/; s/CHANGE_ME_ENC/$(openssl rand -hex 32)/; s/CHANGE_ME_APP/$(openssl rand -hex 32)/" .env
TAG=latest
SERVER_URL=http://app.localhost:3020
PG_DATABASE_PASSWORD=CHANGE_ME_PG
ENCRYPTION_KEY=CHANGE_ME_ENC
APP_SECRET=CHANGE_ME_APP
OPENAI_API_KEY=
