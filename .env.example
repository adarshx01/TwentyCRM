# Application
APP_ROLE=all
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database (Application PostgreSQL - separate from Twenty's DB)
DATABASE_URL=postgresql://crmbee:crmbee_secret@localhost:5432/crmbee
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis (rate limiting and short locks only - no business state)
REDIS_URL=redis://localhost:6379

# Twenty CRM
TWENTY_API_URL=http://localhost:3000
TWENTY_API_RATE_LIMIT=80

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=daily_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Microsoft Teams
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# AI Providers (behind provider interface - swap by config)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1

# Media Storage (S3-compatible - MinIO for dev, GCS with S3 interop for prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=crmbee-media
S3_REGION=us-east-1

# Security
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
ADMIN_API_KEY=change-this-to-a-secure-random-string-at-least-32-chars

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# Draft/Retention (seconds)
DRAFT_EXPIRY_SECONDS=1800
MEDIA_CLEANUP_HOURS=24
MEDIA_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
LOG_RETENTION_DAYS=30

# Twenty client behaviour
TWENTY_API_TIMEOUT_MS=15000
TWENTY_MAX_CONCURRENT_WRITES=2

# Worker concurrency per process (see docs/operations.md for sizing)
WORKER_AI_CONCURRENCY=20
WORKER_CRM_CONCURRENCY=10
WORKER_OUTBOUND_CONCURRENCY=15
WORKER_INTAKE_CONCURRENCY=5
WORKER_REMINDER_CONCURRENCY=5

# Media storage driver: s3 (production) | local (dev only)
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=./.data/media
# Optional ClamAV daemon for upload scanning (SEC-01)
CLAMAV_HOST=
CLAMAV_PORT=3310
# Comma-separated allowlist overrides for media download hosts
MEDIA_ALLOWED_HOSTS=
# JSON map provider -> HMAC secret for inbound-email webhooks, e.g. {"postmark":"..."}
EMAIL_WEBHOOK_SECRETS={}
# Bearer token for GET /metrics (optional; admin API key also accepted)
METRICS_TOKEN=


# Teams: authority used for the bot's outbound token. Multi-tenant bots use botframework.com (default);
# single-tenant bots set their own Entra tenant ID.
TEAMS_AUTH_TENANT=botframework.com

# Queue (BullMQ on Redis). REDIS_URL must be a real Redis (not memory://). Keys are namespaced by QUEUE_PREFIX.
QUEUE_PREFIX=crmbee
QUEUE_OUTBOX_POLL_MS=500
QUEUE_LOCK_DURATION_MS=60000
QUEUE_STALLED_INTERVAL_MS=15000

# Python LangChain conversation agent (agent/). When AGENT_URL is set it replaces the direct OpenAI provider.
AGENT_URL=
AGENT_TOKEN=
