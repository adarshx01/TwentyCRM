PORT=3100
TWENTY_BASE_URL=http://localhost:3000
TWENTY_API_KEY=
TWENTY_WEBHOOK_SECRET=
REDIS_URL=redis://127.0.0.1:6379/1
# Set in hosted environments so /outreach/run is not public.
OUTREACH_API_TOKEN=

# Railway (same project as Redis + twenty-server). See infra/railway/variables.env.example
# REDIS_URL=${{Redis.REDIS_URL}}/1?family=0
# TWENTY_BASE_URL=https://${{twenty-server.RAILWAY_PUBLIC_DOMAIN}}

# Optional. Without a key, drafts use the template fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Local default: never send. Auto mode still writes a draft.
OUTREACH_SEND_ENABLED=false
RESEND_API_KEY=
FROM_EMAIL=sales@recruitmentbricks.ai
FROM_NAME=Recruitment Bricks
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
