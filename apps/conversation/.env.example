# Copy to .env. Do not commit .env.

# API role (subject to RLS). Migrations use MIGRATION_DATABASE_URL as the superuser.
DATABASE_URL=postgresql+psycopg://conversation_app:conversation_app@127.0.0.1:5433/conversation
MIGRATION_DATABASE_URL=postgresql+psycopg://conversation:conversation@127.0.0.1:5433/conversation

# memory | redis. Compose uses redis so the API and worker share a queue.
QUEUE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6380/0

# Operator routes (POST /admin/tenants and the queue drain). Replace outside local dev.
OPERATOR_TOKEN=replace-me

# HMAC for the legacy envelope, POST /intake/email, and POST /intake/forms/{source_id}.
# Header pair: X-Conversation-Timestamp and X-Conversation-Signature: sha256=<hmac of "{timestamp}:{raw body}">.
# Empty rejects those routes. This is not the Meta app secret.
WEBHOOK_SHARED_SECRET=replace-me

# Twenty base URL probed by GET /health (path /healthz). The workspace API key is NOT stored here.
# Tenants store twenty_api_key_ref (secret:// or env://). env://NAME reads that process variable.
TWENTY_BASE_URL=http://localhost:3000

CONFIRMATION_TTL_MINUTES=30
APP_ENV=development
WORKER_MAX_ATTEMPTS=5
SESSION_WINDOW_HOURS=24

# --- WhatsApp Cloud API (Meta). Leave empty until the checklist is done. ---
# developers.facebook.com → your app → WhatsApp → Configuration → Verify token
WHATSAPP_VERIFY_TOKEN=
# App settings → Basic → App secret. Signs X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Business settings → System users → Generate token (whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API Setup → Phone number ID (not the display phone number)
WHATSAPP_PHONE_NUMBER_ID=
# Graph version in the send URL. Current Cloud API examples use v26.0.
WHATSAPP_GRAPH_VERSION=v26.0
# WhatsApp Manager → Message templates. Required for reminders outside the 24-hour window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Microsoft Teams bot. Leave empty until the checklist is done. ---
# Entra app registration → Application (client) ID. Audience of inbound Bot Connector JWTs.
TEAMS_APP_ID=
# Entra → Certificates & secrets → client secret. Also the Azure Bot app password.
TEAMS_APP_PASSWORD=
# Leave empty for a multi-tenant bot (token URL uses tenant botframework.com).
# Set the Directory (tenant) ID only for a single-tenant bot.
TEAMS_TENANT_ID=
# Optional HMAC secret for local envelopes. Not an Azure portal field.
# Ignored for inbound Teams once TEAMS_APP_ID is set (JWT required, no downgrade).
TEAMS_SHARED_SECRET=

# fixture (default) or http. HTTP posts {channel, text} and must return {proposal: ...}.
EXTRACTION_PROVIDER=fixture
EXTRACTION_HTTP_URL=
